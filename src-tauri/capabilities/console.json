{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "console",
  "description": "The console over the game — it is operated, unlike the banner",
  "windows": [
    "console"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-config",
    "allow-ui-error",
    "allow-engine-status",
    "allow-close-console",
    "allow-copy-clip-file",
    "allow-delete-clip",
    "allow-export-for-discord",
    "allow-file-clip",
    "allow-list-clips",
    "allow-save-clip",
    "allow-set-clip-favorite",
    "allow-show-clip-in-app",
    "allow-take-screenshot",
    "allow-toggle-recording",
    "allow-update-audio-source",
    "allow-update-clip",
    "allow-friends-state",
    "allow-friends-accept",
    "allow-friends-remove",
    "allow-share-state",
    "allow-share-accept",
    "allow-share-decline",
    "allow-share-send",
    "allow-link-exists"
  ]
}
