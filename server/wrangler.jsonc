// The friends server: accounts via Discord, friend lists in D1, and one
// Durable Object per user that holds that user's live connection.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clippiboy-friends",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // The app talks to api.clippiboy.com. The workers.dev address stays on, so
  // builds from before the domain keep working.
  "routes": [{ "pattern": "api.clippiboy.com", "custom_domain": true }],
  "workers_dev": true,
  "vars": {
    // Public — it is in every authorize URL anyway. The secret is set with
    // `wrangler secret put DISCORD_CLIENT_SECRET`.
    "DISCORD_CLIENT_ID": "1553530949491236894",
    // Daily ceilings for the routes anyone may call, counted in anon_budget
    // across all addresses: past them /t/ping answers 429 and /auth/start a
    // "busy" page until midnight UTC. A new install's ping writes about 7 rows
    // (two tables, their indexes and the counter), a sign-in start about 3;
    // together that stays under half of D1's free 100k row writes a day. Keep
    // both above the real daily numbers.
    "ANON_PINGS_PER_DAY": "6000",
    "ANON_SIGNINS_PER_DAY": "1500"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clippiboy-friends",
      "database_id": "67470f4b-416f-4180-adf3-6d924f15459d",
      "migrations_dir": "migrations"
    }
  ],
  // Share links: the clips themselves, five days each. The hourly sweep
  // deletes them; a lifecycle rule on the bucket (6 days) is the safety net.
  "r2_buckets": [{ "binding": "CLIPS", "bucket_name": "clippiboy-clips" }],
  "triggers": { "crons": ["17 * * * *"] },
  // Reports from the share page: a few a minute per address, counted at the
  // edge, nothing stored.
  "ratelimits": [
    { "name": "REPORT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    // Routes anyone may call: the usage ping, the start of a sign-in and the
    // exchange that ends it. Without a limit one script could spend the
    // database's daily writes and take sign-in, friends and links down for
    // everybody. Counted per address (an IPv6 address per /64) at the edge,
    // the address not stored.
    { "name": "ANON_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    // Signed-in routes that change something, counted per user id.
    { "name": "USER_LIMIT", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }]
}
