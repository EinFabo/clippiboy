// clippiboy.com in front of the GitHub Pages site. The page itself is still
// built and deployed by .github/workflows/pages.yml, which writes the latest
// release into it — this only gives it the domain.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "clippiboy-site",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [
    { "pattern": "clippiboy.com", "custom_domain": true },
    { "pattern": "www.clippiboy.com", "custom_domain": true }
  ],
  "workers_dev": false,
  // Share links (clippiboy.com/c/<id>) are pages of the friends server. A
  // service binding, because one Worker cannot fetch another on the same zone.
  "services": [{ "binding": "API", "service": "clippiboy-friends" }],
  // Downloads counted per address and minute at most this often; the file is
  // still served past it, only not counted. Without it any script could fill
  // the counts — and the database's daily writes.
  "ratelimits": [{ "name": "DOWNLOAD_LIMIT", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } }],
  // Downloads via clippiboy.com/get/<ref> are counted per link and day in the
  // friends server's database. Written here directly, so there is no public
  // route anyone could call to count.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clippiboy-friends",
      "database_id": "67470f4b-416f-4180-adf3-6d924f15459d",
      "migrations_dir": "../migrations"
    }
  ]
}
